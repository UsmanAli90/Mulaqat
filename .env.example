# Copy to .env for local development. .env is gitignored; this file is the
# tracked template. Every variable Settings reads should appear here.

# Deployment environment: local | test | production
ENVIRONMENT=local
DEBUG=true

# Postgres. Note the +asyncpg driver suffix — SQLAlchemy picks the async
# driver from the URL scheme, and a bare postgresql:// URL will fail at
# engine creation with "async driver required".
DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:5433/booking_dev

# Redis (ARQ background jobs, Phase 5; rate limiting, Phase 4)
REDIS_URL=redis://localhost:6380/0

# The single host's IANA timezone. Never a UTC offset — offsets change
# twice a year in DST regions. This is the fallback until the settings row
# exists (Phase 2), which becomes the source of truth.
HOST_TIMEZONE=Asia/Karachi

# Fernet key encrypting admin_users.totp_secret at rest.
#
#   *** LOSING THIS KEY MEANS LOSING ADMIN ACCESS. ***
#
# The TOTP secret cannot be hashed — verifying a code requires recomputing it
# from the original — so it is encrypted, and this key is the only way back.
# If it is lost, no admin can complete two-factor login and the only recovery
# is to re-enrol every admin's authenticator by writing a new secret directly
# to the database. Back it up somewhere other than the database it protects.
#
# The value below is a DEVELOPMENT key and is public: it is committed to this
# repository. The app refuses to start in production with it. Generate a real
# one per environment:
#
#   uv run python -c "from app.core.encryption import generate_key; print(generate_key())"
TOTP_ENCRYPTION_KEY=tf8oL6aW8GfdvPXWW8N8362knn3S4TxiW4qY6SE9L6c=
